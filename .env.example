# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://scraper:scraper@localhost:5432/scraper

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-64-char-hex-string

# ── Scraper ───────────────────────────────────────────────────────────────────
SCRAPE_INTERVAL_MINUTES=30
# Uncomment to override per platform:
# IDEALISTA_INTERVAL=60
# IMMOBILIARE_INTERVAL=30
# SUBITO_INTERVAL=45

REQUEST_DELAY_SECONDS=3

# Comma-separated proxy URLs (leave empty to disable)
# PROXY_LIST=http://proxy1:8080,http://proxy2:8080

# ── Suggestions ───────────────────────────────────────────────────────────────
# Max price multiplier for roommate apartment suggestions
ROOMMATE_PRICE_MULTIPLIER=1.8

# ── Firebase (FCM) ────────────────────────────────────────────────────────────
# Path to your Firebase service account JSON (never commit this file)
FIREBASE_CREDENTIALS=backend/app/core/firebase-service-account.json

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@idealista-scraper.local

# ── API ───────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=*
LOG_LEVEL=INFO
